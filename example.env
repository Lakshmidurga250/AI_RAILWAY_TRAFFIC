# AI Railway Traffic Optimization & Intelligent Train Management System
# Environment Configuration

# Application
APP_NAME=AI Railway Traffic Optimization System
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=railway-ai-super-secret-production-key-change-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default to SQLite for zero-configuration immediate execution; switch to PostgreSQL for production
DATABASE_URL=sqlite:///./railway_ai.db
# DATABASE_URL=postgresql://railway_user:railway_pass@localhost:5432/railway_traffic

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Simulation Settings
DEFAULT_SIMULATION_TICK_RATE=1.0
MAX_ACCELERATION_FACTOR=60.0
DEFAULT_HEADWAY_SECONDS=180

# AI Model Configuration
MODEL_REGISTRY_PATH=./ai/registry/models
ENABLE_ONLINE_LEARNING=False
RANDOM_SEED=42

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090
